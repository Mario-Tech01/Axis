@startuml C4_Component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Diagrama C4 - Nivel 3
title Backend API - Componentes Internos

LAYOUT_LEFT_RIGHT()

ContainerDb(postgres_ext, "Base de Datos PostgreSQL", "PostgreSQL 15+", "Almacena datos de usuarios, solicitudes, rutas y vehículos")


Container_Boundary(api, "Backend API - FastAPI") {

    ' =========================
    ' CONTROLADORES / ENTRADA
    ' =========================

    Component(authController, "Auth Controller", "FastAPI Controller", "Gestiona autenticación y autorización")

    Component(requestController, "Request Controller", "FastAPI Controller", "Gestiona solicitudes de recogidas médicas")

    Component(routeController, "Route Controller", "FastAPI Controller", "Gestiona asignación y consulta de rutas")

    Component(adminController, "Admin Controller", "FastAPI Controller", "Monitoreo y administración")

    ' =========================
    ' CASOS DE USO
    ' =========================

    Component(createRequestUC, "Crear Solicitud", "Use Case", "Registra solicitudes de recogida")

    Component(assignRouteUC, "Asignar Ruta", "Use Case", "Coordina la optimización y asignación de rutas")

    Component(trackRouteUC, "Monitorear Ruta", "Use Case", "Consulta estados y seguimiento")

    Component(authUC, "Autenticación", "Use Case", "Gestiona login y tokens JWT")

    ' =========================
    ' DOMINIO
    ' =========================

    Component(domainRules, "Reglas de Negocio", "Domain Service", "Validaciones y políticas operativas")

    Component(routeEntity, "Entidad Ruta", "Domain Entity", "Representa rutas médicas")

    Component(requestEntity, "Entidad Solicitud", "Domain Entity", "Representa solicitudes de recogida")

    Component(vehicleEntity, "Entidad Vehículo", "Domain Entity", "Representa vehículos y capacidad")

    ' =========================
    ' PUERTOS
    ' =========================

    Component(routePort, "Puerto de Optimización", "Port Interface", "Contrato para motores de optimización")

    Component(repositoryPort, "Puerto Repositorio", "Port Interface", "Contrato para persistencia")

    Component(notificationPort, "Puerto Notificaciones", "Port Interface", "Contrato para envío de alertas")

    ' =========================
    ' ADAPTADORES
    ' =========================

    Component(aiAdapter, "Adaptador IA", "Adapter", "Conecta con motor IA de rutas")

    Component(dbAdapter, "Adaptador PostgreSQL", "Adapter", "Persistencia de datos")

    Component(notificationAdapter, "Adaptador Notificaciones", "Adapter", "Envía correos y notificaciones push")

    ' =========================
    ' INFRAESTRUCTURA
    ' =========================

    Component(jwtService, "JWT Service", "Security Service", "Generación y validación de tokens")

    Component(queueService, "Queue Service", "RabbitMQ / Redis", "Procesamiento asíncrono")

}


' =========================
' RELACIONES
' =========================

Rel(authController, authUC, "Invoca")
Rel(requestController, createRequestUC, "Invoca")
Rel(routeController, assignRouteUC, "Invoca")
Rel(routeController, trackRouteUC, "Invoca")
Rel(adminController, trackRouteUC, "Consulta")

Rel(authUC, jwtService, "Genera tokens")

Rel(createRequestUC, domainRules, "Valida reglas")
Rel(assignRouteUC, domainRules, "Valida restricciones")

Rel(createRequestUC, requestEntity, "Usa")
Rel(assignRouteUC, routeEntity, "Usa")
Rel(assignRouteUC, vehicleEntity, "Usa")

Rel(assignRouteUC, routePort, "Usa")
Rel(createRequestUC, repositoryPort, "Usa")
Rel(trackRouteUC, repositoryPort, "Consulta")

Rel(routePort, aiAdapter, "Implementado por")
Rel(repositoryPort, dbAdapter, "Implementado por")
Rel(notificationPort, notificationAdapter, "Implementado por")

Rel(aiAdapter, queueService, "Procesa tareas")
Rel(dbAdapter, queueService, "Publica eventos")

Rel(dbAdapter, postgres_ext, "Lee y escribe usando SQLAlchemy (Psycopg2)", "SQL/TCP")

@enduml